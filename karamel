    ).returncode


def cmd_token():
    """Mint the dashboard token, or print the existing one.

    Separate command because the page refuses to listen anywhere but loopback
    without it, and the refusal names this rather than making somebody compose
    a secrets.token_urlsafe call from an error message."""
    import secrets

    path = CONFIG / "dashboard.json"
    CONFIG.mkdir(parents=True, exist_ok=True)
    if path.exists() and "--new" not in sys.argv:
        try:
            tok = json.loads(path.read_text()).get("token", "")
        except (json.JSONDecodeError, OSError):
            tok = ""
        if tok:
            say(f"token   {tok}")
            say(f"link    http://127.0.0.1:8765/?k={tok}")
            say("\nThat link is the password. Pass --new to replace it.")
            return 0
    tok = secrets.token_urlsafe(32)
    path.write_text(json.dumps({"token": tok}, indent=2) + "\n")
    os.chmod(path, 0o600)
    say(f"token   {tok}")
    say(f"link    http://127.0.0.1:8765/?k={tok}")
    say(f"\nWritten to {path}, readable only by you.")
    say("Anyone with that link can read your drafts. It is the password.")
    return 0


