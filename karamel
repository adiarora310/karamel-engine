def cmd_logs():
    """The last thing each component said, newest first.

    Errors, not chatter. Someone running this because something is wrong does
    not want the successful runs, and .log files are almost entirely those."""
    errs = sorted(CONFIG.glob("*.err"), key=lambda p: p.stat().st_mtime,
                  reverse=True)
    errs = [p for p in errs if p.stat().st_size > 0]
    if not errs:
        say(f"No errors logged in {CONFIG}.")
        return 0
    n = 25
    for p in errs:
        age_m = (time.time() - p.stat().st_mtime) / 60
        when = f"{age_m:.0f}m ago" if age_m < 90 else f"{age_m / 60:.0f}h ago"
        say(f"\n=== {p.name}  ({when}, {p.stat().st_size} bytes) ===")
        lines = p.read_text(errors="replace").splitlines()
        for line in lines[-n:]:
            say(f"  {line[:220]}")
    return 0


