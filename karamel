def cmd_migrate():
    """Move ~/.config/cowork to ~/.config/karamel, deliberately.

    Never automatic. That directory holds live credentials, pause state and the
    daily counters of a running system, and silently moving it during a rename
    is how a working install stops working for the sake of a directory name."""
    old = Path.home() / ".config" / "cowork"
    new = Path.home() / ".config" / "karamel"
    if not old.exists():
        say(f"Nothing to migrate: {old} does not exist.")
        return 0
    if new.exists():
        say(f"{new} already exists. Merge by hand, or remove one.")
        return 1
    say(f"About to move {old}")
    say(f"                 -> {new}")
    say()
    say("This directory holds your credentials, pause state and daily counters.")
    if not yes("Move it?", default=False):
        say("Left alone. The old name keeps working indefinitely.")
        return 0
    old.rename(new)
    say("Moved. Stop and start anything running: "
        "./karamel stop && ./karamel start")
    return 0


COMMANDS = {
    "migrate": cmd_migrate,
    "setup": cmd_setup, "draft": cmd_draft, "start": cmd_start,
    "stop": cmd_stop, "status": cmd_status, "voice": cmd_voice,
    "doctor": cmd_doctor, "logs": cmd_logs, "update": cmd_update,
    "dashboard": cmd_dashboard, "web": cmd_dashboard, "token": cmd_token,
    "share": cmd_share,
}

# Every function named cmd_* has to be reachable. Two were written, wired into
# nothing, and printed the usage text instead: the table is edited by hand and a
# missed entry looks exactly like a typo at the prompt.
_unreachable = sorted(
    n[4:] for n, v in list(globals().items())
    if n.startswith("cmd_") and callable(v) and v not in COMMANDS.values()
)
assert not _unreachable, f"cmd_ functions missing from COMMANDS: {_unreachable}"


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    fn = COMMANDS.get(cmd)
    if fn is None:
        say(__doc__.strip())
        return 0 if not cmd else 2
    return fn()


if __name__ == "__main__":
    sys.exit(main())
